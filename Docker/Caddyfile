# Global options: trust the Docker network (cloudflared) so Caddy keeps the
# original X-Forwarded-Proto: https header that Cloudflare sets.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Plain HTTP inside the Docker network; Cloudflare handles HTTPS for visitors
:80 {
	encode gzip

	# Django collects all static files (planner, routes, admin) into
	# <project>/staticfiles via "collectstatic" at startup. Caddy serves them:
	#   /static/planner/css/styles.css -> staticfiles/planner/css/styles.css
	handle_path /static/* {
		root * /srv/app/transport_aggregator_Backend/staticfiles
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else goes to Django (gunicorn)
	handle {
		reverse_proxy app:8000
	}
}
