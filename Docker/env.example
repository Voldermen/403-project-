# Copy to .env (same folder as docker-compose.yml) and fill in.
# NEVER commit .env.

# --- Where the code lives ---
REPO_URL=https://github.com/Voldermen/403-project-
BRANCH=main
# Folder inside the repo that contains manage.py
PROJECT_DIR=transport_aggregator_Backend

# Only needed for private repos (fine-grained PAT with read access to Contents)
GITHUB_TOKEN=

# Seconds between checks for new commits (0 = only pull at startup)
PULL_INTERVAL=600

# --- How to run it ---
# Applies migrations (creates db.sqlite3 / session table), then starts gunicorn.
# Long timeout because the flight/train/bus scrapers can be slow.
START_CMD=python manage.py migrate --noinput && exec gunicorn aggregator_site.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120

# --- Django settings (read by aggregator_site/settings.py) ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# KEEP THE SINGLE QUOTES: Docker Compose treats "$" in unquoted values as a variable.
DJANGO_SECRET_KEY='paste-your-real-key-here'
DJANGO_DEBUG=0
# Your server's public IP, comma-separated, NO spaces. Keep localhost for local testing.
DJANGO_ALLOWED_HOSTS=203.0.113.10,localhost,127.0.0.1
# Must stay 0 while you serve plain HTTP, or browsers drop the session cookie.
# Set to 1 only if you later add HTTPS.
DJANGO_SECURE_COOKIES=0

# --- Geocoding / other API keys ---
# Add your geocoding key here under whatever name the code reads with os.environ.
# (The current backend code doesn't reference one yet.)
