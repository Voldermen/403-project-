# Copy to .env (same folder as docker-compose.yml) and fill in.
# NEVER commit .env. It holds your secret key and tokens.

# --- Where the code lives ---
REPO_URL=https://github.com/youruser/yourrepo.git
BRANCH=main
# Folder inside the repo that contains manage.py
PROJECT_DIR=transport_aggregator_Backend

# Only needed for private repos (classic PAT with "repo" scope, or fine-grained with Contents: read)
GITHUB_TOKEN=

# Seconds between checks for new commits (0 = only pull at startup)
PULL_INTERVAL=600

# --- Cloudflare Tunnel ---
# ONLY the long token string (starts with eyJ). Not the "cloudflared service install" command.
TUNNEL_TOKEN=

# --- How to run it ---
# migrate -> collect static files (served by Caddy) -> start gunicorn.
# Long timeout because the flight/train/bus scrapers can be slow.
START_CMD=python manage.py migrate --noinput && python manage.py collectstatic --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120

# --- Django settings (read by config/settings.py) ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# KEEP THE SINGLE QUOTES: Docker Compose treats "$" in unquoted values as a variable.
DJANGO_SECRET_KEY='paste-your-real-key-here'
DJANGO_DEBUG=0
# Comma-separated, no spaces. Add your public IP too if you still test by IP.
DJANGO_ALLOWED_HOSTS=masterbaconman.net,www.masterbaconman.net,localhost,127.0.0.1
# Browsers send an https:// origin; Django must trust it for form posts.
DJANGO_CSRF_TRUSTED_ORIGINS=https://masterbaconman.net,https://www.masterbaconman.net
# Behind Cloudflare Tunnel + Caddy: believe X-Forwarded-Proto, and don't redirect
# to HTTPS again (Cloudflare already does). Missing these causes ERR_TOO_MANY_REDIRECTS.
DJANGO_TRUST_PROXY=1
DJANGO_SSL_REDIRECT=0

# --- API keys (read from the environment by planner/services.py) ---
# Copy the values from your gitignored api_keys.txt file.
TRANSIT_API_KEY=
TRANSITLAND_API_KEY=
